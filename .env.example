# Public site URL (used in email links, redirects). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Platform URL — where authenticated users go to manage their store
NEXT_PUBLIC_PLATFORM_URL=https://app.wooblitz.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
